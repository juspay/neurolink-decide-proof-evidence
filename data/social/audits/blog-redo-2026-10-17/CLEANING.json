{
 "schema": 1,
 "what": "Log of every file of this audit folder that was rewritten after it was written by the run, to take the machine-specific paths and the gateway's own header values out of it. Counts and hashes only: no replaced value is written here.",
 "rules": [
  {
   "id": "home_prefix",
   "what": "the home-directory prefix of the machine that made the runs, in plain-text files of the kit (kit/environment.json, kit/results.jsonl tracebacks, kit/pass1.log)",
   "replaced_with": "~"
  },
  {
   "id": "temp_dir",
   "what": "the per-user directory the operating system gives to temporary files, as a path prefix, in kit/environment.json of the probe stages",
   "replaced_with": "/tmp/"
  },
  {
   "id": "gateway_headers",
   "what": "response headers of the two XOR probe recordings that identify an internal gateway: every x-litellm-* header, x-typesafe-request-id and x-request-id (the same value as the former); the whole value became the toolkit's header token (lib/mask.mjs headerToken), the form already used for set-cookie, and the file was rewritten with lib/gz.mjs gzipReproducible after a check that every record round-trips through JSON.stringify unchanged",
   "replaced_with": "«masked:header:<name>»"
  }
 ],
 "not_touched_in_this_pass": [
  "wire.jsonl.gz and decide.jsonl.gz of every counted stage (they hold no path of the machine; checked after decompression), and of every other stage except the two XOR probes named above",
  "REMASK.json files (the film counts their entries); the sha256_after of runs/xor/banking77/probe/REMASK.json is the sha256_before of that recording below",
  "the rows files, the notes, the posts, the approval record"
 ],
 "regenerated_afterwards": {
  "what": "files the build writes itself; they were rebuilt by `proof all` after this cleaning, so their new hashes are in MANIFEST.sha256. Their old hashes (the committed state before this cleaning) are listed for the record. audit-config.json is now the toolkit's audit config with the env file paths written with ~, and scan/scan-result.json now names skipped files relative to the audit folder.",
